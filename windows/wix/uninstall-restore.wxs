<?xml version="1.0" encoding="utf-8"?>
<!--
  Hertzline MSI uninstall restore (HZ-049 / AC-7.3).
  Pulled in via tauri.windows.bundle.json:
    bundle.windows.wix.fragmentPaths + componentRefs = HertzlineRestoreMarker
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <DirectoryRef Id="INSTALLDIR">
      <Component Id="HertzlineRestoreMarker" Guid="8f3c2a1b-4d5e-6f70-8192-a3b4c5d6e7f8">
        <RegistryValue
          Root="HKCU"
          Key="Software\Hertzline\Hertzline"
          Name="UninstallRestore"
          Type="integer"
          Value="1"
          KeyPath="yes"
        />
      </Component>
    </DirectoryRef>

    <CustomAction
      Id="HertzlineRestoreAll"
      Directory="INSTALLDIR"
      ExeCommand="cmd.exe /c if exist &quot;[INSTALLDIR]hertzline-helper.exe&quot; (&quot;[INSTALLDIR]hertzline-helper.exe&quot; restore_all --reason uninstall --json) else if exist &quot;[INSTALLDIR]resources\hertzline-helper.exe&quot; (&quot;[INSTALLDIR]resources\hertzline-helper.exe&quot; restore_all --reason uninstall --json)"
      Execute="deferred"
      Impersonate="no"
      Return="ignore"
    />

    <InstallExecuteSequence>
      <Custom Action="HertzlineRestoreAll" Before="RemoveFiles">REMOVE="ALL"</Custom>
    </InstallExecuteSequence>
  </Fragment>
</Wix>
